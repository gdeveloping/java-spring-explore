<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.gdev.springbasicexplore.jdbc.mapper.UserOrderMapper">

    <resultMap id="userMapForCallProcedure" type="tech.gdev.springbasicexplore.jdbc.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="birthday" column="birthday"/>
        <result property="password" column="password"/>
        <collection property="orderList" ofType="tech.gdev.springbasicexplore.jdbc.entity.Order" resultSet="orders">
            <id property="id" column="id"/>
            <result property="userId" column="user_id"/>
            <result property="name" column="name"/>
        </collection>
    </resultMap>

    <select id="selectUserAndOrdersByCallProcedure" statementType="CALLABLE" resultSets="users,orders" resultMap="userMapForCallProcedure">
        {call get_user_and_orders(#{id})}
    </select>

    <resultMap id="orderMap" type="tech.gdev.springbasicexplore.jdbc.entity.Order">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="name" column="name"/>
    </resultMap>

    <select id="selectOrderByUserId" parameterType="int" resultType="tech.gdev.springbasicexplore.jdbc.entity.Order" resultMap="orderMap">
        select * from `order` where user_id = #{id}
    </select>

    <resultMap id="userMapForSubQuery" type="tech.gdev.springbasicexplore.jdbc.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="birthday" column="birthday"/>
        <result property="password" column="password"/>
        <collection property="orderList" javaType="java.util.ArrayList" ofType="tech.gdev.springbasicexplore.jdbc.entity.Order" select="selectOrderByUserId" column="id"/>
    </resultMap>

    <select id="selectUserAndOrdersBySubQuery" parameterType="int" resultMap="userMapForSubQuery">
        select * from `user` where id = #{id}
    </select>

    <resultMap id="orderMapForFlatData" type="tech.gdev.springbasicexplore.jdbc.entity.Order">
        <id property="id" column="order_id"/>
        <result property="name" column="order_name"/>
        <result property="userId" column="user_id"/>
    </resultMap>

    <resultMap id="userMapForFlatData" type="tech.gdev.springbasicexplore.jdbc.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="birthday" column="birthday"/>
        <result property="password" column="password"/>
        <collection property="orderList" ofType="tech.gdev.springbasicexplore.jdbc.entity.Order" resultMap="orderMapForFlatData"/>
    </resultMap>

    <select id="selectUserAndOrdersByFlatData" parameterType="java.lang.Integer" resultMap="userMapForFlatData">
        SELECT
            u.id,
            u.username,
            u.birthday,
            u.password,
            o.id AS order_id,
            o.name AS order_name,
            o.user_id
        FROM
            `user` u
                LEFT JOIN
            `order` o ON u.id = o.user_id
        <if test="id != null">
        WHERE u.id = #{id}
        </if>
    </select>

    <select id="selectOrderById" parameterType="int" resultType="tech.gdev.springbasicexplore.jdbc.entity.Order" resultMap="orderMap">
        select * from `order` where id = #{id}
    </select>
</mapper>
