<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.gdev.springbasicexplore.jdbc.mapper.TestCodeMapper">

    <resultMap id="BaseResultMap" type="tech.gdev.springbasicexplore.jdbc.entity.TestCode">
        <id column="id" property="id" />
        <result column="code" property="code" />
        <result column="note" property="note" />
    </resultMap>

    <select id="selectByOption" resultMap="BaseResultMap">
        SELECT * FROM test_code
        <where>
            <if test="param.id != null">
                and id = #{param.id}
            </if>
            <if test="param.code != null">
                and code = #{param.code}
            </if>
            <if test="param.note != null">
                and note = #{param.note}
            </if>
        </where>
    </select>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT * FROM test_code WHERE code = #{code}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM test_code
    </select>

    <delete id="deleteByIds">
        DELETE FROM test_code
        WHERE id in
        <foreach collection="param" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </delete>
</mapper>